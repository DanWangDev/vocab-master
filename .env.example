# Vocab Master Environment Configuration
# Copy this file to .env and fill in your values

# Vite API URL for frontend (base URL without /api — endpoints include /api explicitly)
VITE_API_URL=http://localhost:9876

# Node environment
NODE_ENV=development

# JWT Secret - REQUIRED: Generate a secure random string (at least 32 characters)
# Example: openssl rand -hex 32
JWT_SECRET=your-secure-jwt-secret-here-change-this

# Frontend port (default: 8080)
FRONTEND_PORT=8080

# Backend port (default: 9876)
BACKEND_PORT=9876

# CORS origin - URL of your frontend (for production)
# Include the protocol and port if not 80/443
# Example: https://vocab.yourdomain.com
CORS_ORIGIN=http://localhost:8080

# Hub OIDC Authentication (required — all auth is delegated to 11plus-hub)
# OIDC issuer URL (the 11plus-hub instance)
OIDC_ISSUER=http://localhost:3009
# Internal issuer URL for Docker container-to-hub networking (falls back to OIDC_ISSUER)
OIDC_INTERNAL_ISSUER=http://localhost:3009
# OIDC client ID registered in the hub
OIDC_CLIENT_ID=vocab-master-client
# OIDC client secret (confidential client — backend-only, never exposed to frontend)
OIDC_CLIENT_SECRET=
# Frontend OIDC config (VITE_ prefix required for Vite)
VITE_OIDC_ISSUER=http://localhost:3009
VITE_OIDC_CLIENT_ID=vocab-master-client

# GitHub Packages token for @danwangdev/auth-client (classic PAT with read:packages scope)
NODE_AUTH_TOKEN=
